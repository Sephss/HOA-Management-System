<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="18dp">

        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_circle_gold" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/baseline_pending_24"
            app:tint="@color/golden" />

    </FrameLayout>

    <TextView
        android:id="@+id/pendingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Account Pending Approval"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/green"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/pendingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your account has been verified, but it still needs to be reviewed and approved by the HOA Admin before you can log in."
        android:textSize="14sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#5A5A5A"
        android:layout_marginBottom="6dp" />


    <Button
        android:id="@+id/pendingOkBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Okay, Got It"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_btn_green_rounded"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>