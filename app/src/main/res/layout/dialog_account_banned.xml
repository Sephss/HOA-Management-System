<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="18dp">

        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_banned" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/banned_icon" />

    </FrameLayout>

    <TextView
        android:id="@+id/bannedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Account Banned"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/green"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/bannedMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your account has been banned by the HOA Admin due to a violation of community policies."
        android:textSize="14sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#5A5A5A"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/bannedSubMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="For inquiries or appeals, please contact your HOA Admin office directly."
        android:textSize="12sp"
        android:textAlignment="center"
        android:textStyle="italic"
        android:textColor="#9A9A9A"
        android:layout_marginBottom="22dp" />

    <Button
        android:id="@+id/bannedOkBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Okay, Got It"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_btn_green_rounded"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>