<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingTop="28dp"
    android:paddingBottom="24dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="18dp">

        <View
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_icon_circle_green" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:src="@drawable/close_app_icon" />

    </FrameLayout>

    <TextView
        android:id="@+id/closedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We're Currently Closed"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/green"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/closedMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The app is available from 6:00 AM to 8:00 PM daily. Please come back within our operating hours."
        android:textSize="14sp"
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:textColor="#5A5A5A"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/closedSubMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thank you for your understanding."
        android:textSize="12sp"
        android:textAlignment="center"
        android:textStyle="italic"
        android:textColor="#9A9A9A"
        android:layout_marginBottom="22dp" />

    <Button
        android:id="@+id/closedOkBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Okay, Got It"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_btn_green_rounded"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>